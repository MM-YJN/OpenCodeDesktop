<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarnForTestProjects)</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenCodeDesktop.Infrastructure\OpenCodeDesktop.Infrastructure.csproj" />
    <ProjectReference Include="..\OpenCodeDesktop.CliFixture\OpenCodeDesktop.CliFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyCliFixture" AfterTargets="Build">
    <ItemGroup>
      <CliFixtureFiles Include="../OpenCodeDesktop.CliFixture/bin/$(Configuration)/net10.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(CliFixtureFiles)" DestinationFolder="$(OutDir)CliFixture" />
  </Target>

</Project>
