<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenCodeDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OpenCode Desktop">
    <Grid x:Name="ShellRoot" Background="{ThemeResource ShellSurfaceBrush}" Loaded="ShellRoot_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <NavigationView
            x:Name="ShellNavigation"
            AutomationProperties.Name="Main navigation"
            PaneTitle="OpenCode Desktop"
            PaneDisplayMode="LeftCompact"
            IsPaneOpen="False"
            OpenPaneLength="{StaticResource ShellNavigationWidth}"
            CompactPaneLength="{StaticResource ShellNavigationCompactWidth}"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="ShellNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="WorkspaceDestination" Content="Workspace" AutomationProperties.Name="Workspace">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ConnectionDestination" Content="Connection" AutomationProperties.Name="Connection">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Link" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <ContentControl x:Name="ShellContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>
        <Border
            Grid.Row="1"
            Background="{ThemeResource ShellStatusSurfaceBrush}"
            BorderBrush="{ThemeResource ShellBorderBrush}"
            BorderThickness="{StaticResource ShellStatusBorderThickness}"
            Padding="{StaticResource ShellStatusPadding}">
            <TextBlock
                x:Name="ConnectionStatusText"
                Text="Connection: Disconnected"
                AutomationProperties.Name="Server connection: Disconnected"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource ShellDisconnectedBrush}"
                Style="{StaticResource ShellBodyTextStyle}" />
        </Border>
    </Grid>
</Window>
