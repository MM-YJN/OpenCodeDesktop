<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenCodeDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OpenCode Desktop">
    <Grid x:Name="ShellRoot" Background="{ThemeResource ShellSurfaceBrush}" Loaded="ShellRoot_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="ShellContentHost" />
        <Border
            Grid.Row="1"
            Background="{ThemeResource ShellStatusSurfaceBrush}"
            BorderBrush="{ThemeResource ShellBorderBrush}"
            BorderThickness="{StaticResource ShellStatusBorderThickness}"
            Padding="{StaticResource ShellStatusPadding}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock
                x:Name="ConnectionStatusText"
                Text="Connection: Disconnected · Sample data"
                AutomationProperties.Name="Server connection: Disconnected"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource ShellDisconnectedBrush}"
                Style="{StaticResource ShellBodyTextStyle}" VerticalAlignment="Center" />
                <Button x:Name="AttentionButton" Grid.Column="1" Content="Needs attention: 0" Click="Attention_Click"
                        AutomationProperties.LiveSetting="Polite"/>
            </Grid>
        </Border>
    </Grid>
</Window>
