<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenCodeDesktop.Views.DetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:OpenCodeDesktop.Presentation"
    xmlns:views="using:OpenCodeDesktop.Views">
    <Grid>
        <Pivot x:Name="DetailsPivot" AutomationProperties.Name="Details" SelectionChanged="Details_SelectionChanged">
            <PivotItem Header="Info" AutomationProperties.Name="Session information">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="0,4,0,16" Spacing="12">
                        <TextBlock x:Name="InfoTitle" Style="{StaticResource ShellSubheadingTextStyle}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level3" />
                        <TextBlock x:Name="InfoSubtitle" Style="{StaticResource ShellTertiaryTextStyle}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource ShellDividerStyle}" />
                        <ItemsControl x:Name="InfoFields" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="presentation:DetailFieldPresentation">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource ShellTertiaryTextStyle}" TextWrapping="NoWrap" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource ShellSecondaryTextStyle}" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource ShellSubtleCardStyle}">
                            <StackPanel Spacing="{StaticResource ShellSpaceSmall}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShellSpaceSmall}">
                                    <FontIcon Glyph="{StaticResource ShellIconInfo}" FontFamily="{StaticResource ShellIconFontFamily}"
                                              FontSize="{StaticResource ShellIconSmall}" Foreground="{ThemeResource ShellInfoBrush}" IsHitTestVisible="False" />
                                    <TextBlock Text="Review and tools" Style="{StaticResource ShellCaptionTextStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="UnavailableMessage" Style="{StaticResource ShellTertiaryTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Changes" AutomationProperties.Name="Changes"><views:ChangeReviewView x:Name="ReviewContent"/></PivotItem>
        </Pivot>
    </Grid>
</UserControl>
