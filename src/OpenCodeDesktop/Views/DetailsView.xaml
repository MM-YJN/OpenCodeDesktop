<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenCodeDesktop.Views.DetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Pivot x:Name="DetailsPivot" AutomationProperties.Name="Details">
            <PivotItem Header="Info" AutomationProperties.Name="Session information">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="InfoPanel" Padding="0,4,0,16" Spacing="12" />
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="Files" IsEnabled="False" ToolTipService.ToolTip="File browsing is not available in this release" />
            <PivotItem Header="Changes" IsEnabled="False" ToolTipService.ToolTip="Change review is not available in this release" />
        </Pivot>
    </Grid>
</UserControl>
