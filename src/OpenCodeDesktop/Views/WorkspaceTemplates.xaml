<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="BodyTextTemplate">
        <TextBlock Style="{StaticResource ShellSelectableBodyTextStyle}"/>
    </DataTemplate>
    <DataTemplate x:Key="MessageTemplate">
        <Border Style="{StaticResource ShellCardStyle}">
            <TextBlock x:Name="Message" Style="{StaticResource ShellSelectableBodyTextStyle}"/>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="ActionTemplate">
        <Button/>
    </DataTemplate>
</ResourceDictionary>
