<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="AddProjectDialogTemplate">
        <ContentDialog Title="Add project" PrimaryButtonText="Add project" CloseButtonText="Cancel" DefaultButton="Primary">
            <StackPanel Spacing="{StaticResource ShellSpaceSmall}">
                <TextBlock Text="Open a directory that exists on the selected server. The client does not read this path locally." Style="{StaticResource ShellSecondaryTextStyle}" VerticalAlignment="Center" />
                <TextBox x:Name="Directory" Header="Server-side directory" PlaceholderText="Path on the selected server" MaxLength="4096"
                         AutomationProperties.Name="Server-side project directory" AutomationProperties.AutomationId="AddProjectDirectory" />
            </StackPanel>
        </ContentDialog>
    </DataTemplate>
    <DataTemplate x:Key="SearchSessionsDialogTemplate">
        <ContentDialog PrimaryButtonText="Search" CloseButtonText="Cancel" DefaultButton="Primary">
            <StackPanel Spacing="12">
                <AutoSuggestBox x:Name="Query" Header="Session title" PlaceholderText="Empty search shows all titles"
                                AutomationProperties.Name="Search session titles" AutomationProperties.AutomationId="SessionTitleSearch" />
                <ToggleSwitch x:Name="Archived" Header="Archived history" AutomationProperties.AutomationId="SessionSearchArchived" />
            </StackPanel>
        </ContentDialog>
    </DataTemplate>
    <DataTemplate x:Key="RenameSessionDialogTemplate">
        <ContentDialog Title="Rename session" PrimaryButtonText="Rename" CloseButtonText="Cancel" DefaultButton="Primary">
            <StackPanel Spacing="12">
                <TextBox x:Name="TitleInput" Header="Session title" AutomationProperties.Name="New session title" AutomationProperties.AutomationId="SessionRenameTitle" />
                <TextBlock x:Name="Guidance" Style="{StaticResource ShellSecondaryTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </ContentDialog>
    </DataTemplate>
    <DataTemplate x:Key="ConversationNoticeTemplate">
        <Border Style="{StaticResource ShellSubtleCardStyle}" Padding="12,9">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShellSpaceSmall}">
                <FontIcon x:Name="Icon" Glyph="{StaticResource ShellIconInfo}" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconSmall}" IsHitTestVisible="False" />
                <TextBlock x:Name="Message" Style="{StaticResource ShellSecondaryTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="UserEntryTemplate">
        <StackPanel HorizontalAlignment="Right" MaxWidth="620" Spacing="4">
            <Border Background="{ThemeResource ShellAccentSurfaceBrush}" BorderBrush="{ThemeResource ShellAccentBrush}"
                    BorderThickness="{StaticResource ShellHairlineThickness}" CornerRadius="{StaticResource ShellCornerRadiusLarge}" Padding="14,10">
                <StackPanel x:Name="Segments" Spacing="6" />
            </Border>
            <TextBlock x:Name="Caption" Style="{StaticResource ShellCaptionTextStyle}" HorizontalAlignment="Right" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="AssistantEntryTemplate">
        <StackPanel x:Name="Segments" Spacing="8" HorizontalAlignment="Left" />
    </DataTemplate>
    <DataTemplate x:Key="DividerEntryTemplate">
        <TextBlock x:Name="Label" Style="{StaticResource ShellTertiaryTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="620" Margin="0,-6,0,-6" />
    </DataTemplate>
    <DataTemplate x:Key="ToolEntryTemplate">
        <Border Style="{StaticResource ShellCardStyle}" Padding="0">
            <StackPanel>
                <Button x:Name="Header" Style="{StaticResource ShellQuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon x:Name="Icon" Glyph="{StaticResource ShellIconTool}" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconSmall}" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Title" Style="{StaticResource ShellBodyStrongTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="Subtitle" Style="{StaticResource ShellTertiaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ProgressRing x:Name="Running" Width="14" Height="14" IsActive="True" Visibility="Collapsed" IsHitTestVisible="False" />
                            <TextBlock x:Name="Status" Style="{StaticResource ShellTertiaryTextStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
                            <FontIcon x:Name="Chevron" Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource ShellTextTertiaryBrush}" IsHitTestVisible="False" />
                        </StackPanel>
                    </Grid>
                </Button>
                <ContentControl x:Name="Output" Padding="12,0,12,10" Visibility="Collapsed" HorizontalContentAlignment="Stretch" />
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="ActivityEntryTemplate">
        <Border Style="{StaticResource ShellCardStyle}" Padding="0">
            <StackPanel>
                <Button x:Name="Header" Style="{StaticResource ShellQuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon x:Name="Icon" Glyph="{StaticResource ShellIconTool}" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconSmall}" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Title" Style="{StaticResource ShellBodyStrongTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="Subtitle" Style="{StaticResource ShellTertiaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ProgressRing x:Name="Running" Width="14" Height="14" IsActive="True" Visibility="Collapsed" IsHitTestVisible="False" />
                            <FontIcon x:Name="Chevron" Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource ShellTextTertiaryBrush}" IsHitTestVisible="False" />
                        </StackPanel>
                    </Grid>
                </Button>
                <StackPanel x:Name="Items" Spacing="6" Padding="12,0,12,10" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="ThinkingEntryTemplate">
        <StackPanel>
            <Button x:Name="Header" Style="{StaticResource ShellQuietButtonStyle}" Padding="8,4" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Thinking" Style="{StaticResource ShellTertiaryTextStyle}" VerticalAlignment="Center" />
                    <FontIcon x:Name="Chevron" Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource ShellTextTertiaryBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="Body" Style="{StaticResource ShellSelectableBodyTextStyle}" Foreground="{ThemeResource ShellTextTertiaryBrush}" TextWrapping="Wrap" Margin="10,2,0,0" Visibility="Collapsed" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="WorkingIndicatorTemplate">
        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,2">
            <ProgressRing x:Name="Indicator" Width="16" Height="16" IsActive="True" />
            <TextBlock x:Name="Label" Style="{StaticResource ShellTertiaryTextStyle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ErrorEntryTemplate">
        <Border Style="{StaticResource ShellCardStyle}" Background="{ThemeResource ShellDangerSurfaceBrush}" BorderBrush="{ThemeResource ShellDangerBrush}" Padding="12,10">
            <StackPanel x:Name="Segments" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShellSpaceSmall}">
                    <FontIcon Glyph="{StaticResource ShellIconError}" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconSmall}" Foreground="{ThemeResource ShellDangerBrush}" IsHitTestVisible="False" />
                    <TextBlock x:Name="Title" Style="{StaticResource ShellBodyStrongTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="CodeBlockTemplate">
        <Border Style="{StaticResource ShellCodeBlockStyle}" Padding="0">
            <ScrollViewer x:Name="Scroll" MaxHeight="280" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" Padding="10,8">
                <TextBlock x:Name="Code" VerticalAlignment="Center" />
            </ScrollViewer>
        </Border>
    </DataTemplate>
</ResourceDictionary>
