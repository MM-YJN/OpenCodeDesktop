<UserControl
    x:Class="OpenCodeDesktop.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OpenCodeDesktop.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkspaceTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <SplitView x:Name="ProjectsLayout" SizeChanged="ProjectsLayout_SizeChanged"
                   OpenPaneLength="{StaticResource ShellProjectsPanelWidth}" CompactPaneLength="0" DisplayMode="Inline">
            <SplitView.Pane>
                <Grid Width="{StaticResource ShellProjectsPanelWidth}" Padding="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <Button x:Name="ServerSelector" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Switch server">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft"/>
                            </Button.Flyout>
                            <TextBlock Text="Select server ▾" Style="{StaticResource ShellBodyTextStyle}"/>
                        </Button>
                        <TextBlock Text="Projects" Style="{StaticResource ShellHeadingTextStyle}"/>
                        <Button Content="Close Projects" Click="CloseProjects_Click"/>
                        <Button x:Name="NewTaskButton" Content="New-session draft" IsEnabled="False" Click="NewTask_ClickAsync"/>
                        <StackPanel x:Name="LiveProjectControls" Spacing="8">
                            <TextBox x:Name="ServerDirectory" IsEnabled="False" Header="Server-side directory" PlaceholderText="Path on the selected server" AutomationProperties.Name="Server-side project directory"/>
                            <Button x:Name="OpenDirectoryButton" Content="Open directory" IsEnabled="False" Click="OpenDirectory_ClickAsync"/>
                            <ProgressBar x:Name="WorkspaceLoading" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Loading server workspace"/>
                            <TextBlock x:Name="WorkspaceStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="WorkspaceError" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" IsTextSelectionEnabled="True"/>
                            <Button x:Name="WorkspaceRetry" Content="Retry loading" Click="RetryWorkspace_ClickAsync" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8">
                        <StackPanel x:Name="ProjectList" Spacing="8"/>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="Settings" Click="Settings_Click"/>
                </Grid>
            </SplitView.Pane>
            <views:PaneOnlySplitView x:Name="DetailsLayout" PanePlacement="Right" CompactPaneLength="0" SizeChanged="DetailsLayout_SizeChanged">
                <SplitView.Pane>
                    <Grid x:Name="DetailsRegion">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Thumb x:Name="DetailsGrip" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DragDelta="DetailsGrip_DragDelta"
                               AutomationProperties.Name="Resize Details with Left and Right arrows" KeyDown="DetailsGrip_KeyDown" IsTabStop="True"/>
                        <Grid Grid.Column="1" Padding="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Details" Style="{StaticResource ShellHeadingTextStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ExpandButton" Content="Expand" Click="Expand_Click"/>
                                    <Button Content="Close Details" Click="CloseDetails_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="LiveDetails" Grid.Row="1" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="Details, files, changes, terminal and attention requests are unavailable in this increment. Conversation entries show recorded history only."/>
                        </Grid>
                    </Grid>
                </SplitView.Pane>
                <Grid x:Name="CentralWorkspace">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border BorderBrush="{ThemeResource ShellBorderBrush}" BorderThickness="0,0,0,1" Padding="12">
                        <StackPanel Spacing="8">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ProjectsToggle" Content="Projects" Click="Projects_Click"/>
                                    <Button x:Name="DetailsToggle" Content="Details" Click="Details_Click"/>
                                    <Button x:Name="TerminalToggle" Content="Terminal unavailable" IsEnabled="False"/>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock x:Name="SessionTitle" Text="Workspace" Style="{StaticResource ShellHeadingTextStyle}"/>
                            <TextBlock x:Name="SessionPath" Text="No server connected · No session selected" Style="{StaticResource ShellSecondaryTextStyle}"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" IsTabStop="True" AutomationProperties.Name="Conversation history">
                        <StackPanel x:Name="Conversation" Padding="16" Spacing="16"/>
                    </ScrollViewer>
                    <ScrollViewer x:Name="ComposerScroll" Grid.Row="3" MaxHeight="{StaticResource ShellComposerMaximumHeight}" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Composer" Padding="12" Spacing="8"/>
                    </ScrollViewer>
                </Grid>
            </views:PaneOnlySplitView>
        </SplitView>
    </Grid>
</UserControl>
