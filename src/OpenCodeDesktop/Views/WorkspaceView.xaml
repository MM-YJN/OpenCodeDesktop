<UserControl
    x:Class="OpenCodeDesktop.Views.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OpenCodeDesktop.Views">
    <Grid>
        <SplitView x:Name="ProjectsLayout" SizeChanged="ProjectsLayout_SizeChanged"
                   OpenPaneLength="{StaticResource ShellProjectsPanelWidth}" CompactPaneLength="0" DisplayMode="Inline">
            <SplitView.Pane>
                <Grid Width="{StaticResource ShellProjectsPanelWidth}" Padding="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Projects" Style="{StaticResource ShellHeadingTextStyle}"/>
                        <Button Content="Close Projects" Click="CloseProjects_Click"/>
                        <Button x:Name="NewTaskButton" Content="New task" Click="NewTask_Click"/>
                        <TextBox x:Name="SearchBox" PlaceholderText="Search projects / sessions" AutomationProperties.Name="Search projects or sessions" TextChanged="Search_Changed"/>
                        <Button Content="Clear search" Click="ClearSearch_Click"/>
                        <CheckBox x:Name="ArchivedFilter" Content="Show archived" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8">
                        <StackPanel x:Name="ProjectList" Spacing="8"/>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="Settings" Click="Settings_Click"/>
                </Grid>
            </SplitView.Pane>
            <views:PaneOnlySplitView x:Name="DetailsLayout" PanePlacement="Right" CompactPaneLength="0" SizeChanged="DetailsLayout_SizeChanged">
                <SplitView.Pane>
                    <Grid x:Name="DetailsRegion">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Thumb x:Name="DetailsGrip" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DragDelta="DetailsGrip_DragDelta"
                               AutomationProperties.Name="Resize Details with Left and Right arrows" KeyDown="DetailsGrip_KeyDown" IsTabStop="True"/>
                        <Grid Grid.Column="1" Padding="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Details" Style="{StaticResource ShellHeadingTextStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ExpandButton" Content="Expand" Click="Expand_Click"/>
                                    <Button Content="Close Details" Click="CloseDetails_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <ContentControl x:Name="DetailsHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                        </Grid>
                    </Grid>
                </SplitView.Pane>
                <Grid x:Name="CentralWorkspace">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border BorderBrush="{ThemeResource ShellBorderBrush}" BorderThickness="0,0,0,1" Padding="12">
                        <StackPanel Spacing="8">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ProjectsToggle" Content="Projects" Click="Projects_Click"/>
                                    <Button x:Name="DetailsToggle" Content="Details" Click="Details_Click"/>
                                    <Button x:Name="TerminalToggle" Content="Terminal" Click="Terminal_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock x:Name="SessionTitle" Text="Workspace" Style="{StaticResource ShellHeadingTextStyle}"/>
                            <TextBlock x:Name="SessionPath" Text="No server connected · No session selected" Style="{StaticResource ShellSecondaryTextStyle}"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" ViewChanged="Conversation_ViewChanged">
                        <StackPanel x:Name="Conversation" Padding="16" Spacing="16"/>
                    </ScrollViewer>
                    <Border x:Name="TerminalRegion" Grid.Row="2" Height="{StaticResource ShellTerminalHeight}" Visibility="Collapsed" BorderBrush="{ThemeResource ShellBorderBrush}" BorderThickness="0,1,0,0" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="TerminalSelection" SelectedIndex="0" AutomationProperties.Name="Sample terminal" SelectionChanged="Terminal_Changed">
                                        <x:String>Verification sample</x:String><x:String>Build sample</x:String>
                                    </ComboBox>
                                    <Button Content="Clear" Click="ClearTerminal_Click"/>
                                    <Button Content="Reset output" Click="ResetTerminal_Click"/>
                                    <Button Content="Close terminal" Click="CloseTerminal_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TerminalOutput" FontFamily="Consolas" IsTextSelectionEnabled="True"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="ComposerScroll" Grid.Row="3" MaxHeight="{StaticResource ShellComposerMaximumHeight}" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Composer" Padding="12" Spacing="8"/>
                    </ScrollViewer>
                </Grid>
            </views:PaneOnlySplitView>
        </SplitView>
    </Grid>
</UserControl>
