<UserControl
    x:Class="OpenCodeDesktop.Views.ProjectFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" SizeChanged="Files_SizeChanged">
    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock x:Name="FilesHeading" Text="Files" Style="{StaticResource ShellHeadingTextStyle}" AutomationProperties.HeadingLevel="Level1" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="Identity" Style="{StaticResource ShellBodyStrongTextStyle}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ServerDirectory" Style="{StaticResource ShellCaptionTextStyle}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PreviewLimits" Text="Read-only · Preview up to 256 KiB / 100,000 characters · Search up to 100 results" Style="{StaticResource ShellTertiaryTextStyle}"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="BrowserColumn" Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{ThemeResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ShellCornerRadiusMedium}" Padding="8">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Expander x:Name="DirectoryNavigation" Header="Directory" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinWidth="0" Padding="0" AutomationProperties.Name="Directory navigation">
                <StackPanel Spacing="6">
                <TextBox x:Name="DirectoryInput" Header="Server directory path" PlaceholderText="Project root" MaxLength="4096" AutomationProperties.Name="Directory relative to project root" KeyDown="Directory_KeyDown"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="FilesGo" Content="Go" Click="Go_ClickAsync" AutomationProperties.Name="Open server directory"/>
                    <Button x:Name="FilesRoot" Content="Root" Click="Root_ClickAsync" AutomationProperties.Name="Project root directory"/>
                    <Button x:Name="FilesRefresh" Content="↻" Click="Refresh_ClickAsync" AutomationProperties.Name="Refresh files and selected preview" ToolTipService.ToolTip="Refresh files and preview"/>
                </StackPanel>
                </StackPanel>
                </Expander>
                <TextBox x:Name="SearchInput" Grid.Row="1" Header="Find filename in project" MaxLength="512" TextChanged="Search_TextChangedAsync" AutomationProperties.Name="Find filename in project"/>
                <StackPanel Grid.Row="2" Spacing="4">
                    <TextBlock x:Name="ListStatus" Style="{StaticResource ShellCaptionTextStyle}" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="RetryList" Content="Retry listing" Click="Go_ClickAsync" Visibility="Collapsed"/>
                </StackPanel>
                <ListView x:Name="Entries" Grid.Row="3" IsItemClickEnabled="True" ItemClick="Entries_ItemClickAsync" AutomationProperties.Name="Server project files"/>
            </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="{ThemeResource ShellBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ShellCornerRadiusMedium}" Padding="12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="SelectedPath" Style="{StaticResource ShellCaptionTextStyle}" TextWrapping="Wrap" MaxLines="3" IsTextSelectionEnabled="True"/>
                <StackPanel Grid.Row="1" Spacing="4">
                    <Button x:Name="AddPromptFile" Content="Add to prompt" Click="AddToPrompt_ClickAsync" AutomationProperties.AutomationId="AddPromptFile" AutomationProperties.Name="Add selected server file to prompt" ToolTipService.ToolTip="Add to this project's current draft, or open a new-session draft for this project. Up to four text files with complete previews, 256 KiB / 100,000 characters each." />
                    <TextBlock x:Name="AttachmentStatus" Style="{StaticResource ShellCaptionTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="PreviewStatus" Style="{StaticResource ShellCaptionTextStyle}" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="RetryPreview" Content="Retry preview" Click="RetryPreview_ClickAsync" Visibility="Collapsed"/>
                </StackPanel>
                <ScrollViewer x:Name="PreviewScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsTabStop="True" AutomationProperties.Name="Read-only file preview">
                    <TextBlock x:Name="PreviewText" Style="{StaticResource ShellCodeTextStyle}" IsTextSelectionEnabled="True" TextWrapping="NoWrap"/>
                </ScrollViewer>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
