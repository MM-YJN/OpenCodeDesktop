<UserControl
    x:Class="OpenCodeDesktop.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="{StaticResource ShellSpaceSmall}">
            <Button Content="Return to Workspace" Click="Return_Click"/>
            <TextBlock Text="Settings" Style="{StaticResource ShellSelectableHeadingTextStyle}"/>
            <TextBlock x:Name="FeedbackText" Text="Connection checks contact the selected server. Profiles and preferences last for this app session only."
                       Style="{StaticResource ShellSelectableBodyTextStyle}"/>
            <ComboBox x:Name="Sections" Header="Section" AutomationProperties.Name="Section" HorizontalAlignment="Stretch" SelectionChanged="Sections_Changed">
                <x:String>Connections</x:String>
                <x:String>Models &amp; Providers</x:String>
                <x:String>Extensions</x:String>
                <x:String>Permissions</x:String>
                <x:String>Appearance</x:String>
                <x:String>Notifications</x:String>
            </ComboBox>
        </StackPanel>
        <Grid x:Name="Pages" Grid.Row="1">
            <ContentControl x:Name="ConnectionsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            <ScrollViewer Style="{StaticResource ShellWorkspaceScrollStyle}" Visibility="Collapsed">
                <StackPanel Spacing="{StaticResource ShellSpaceSmall}">
                    <TextBlock Text="Models &amp; Providers" Style="{StaticResource ShellSelectableHeadingTextStyle}"/>
                    <ComboBox x:Name="DefaultModel" Header="Default sample model" AutomationProperties.Name="Default sample model" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <x:String>Sample reasoning model</x:String><x:String>Sample fast model</x:String>
                    </ComboBox>
                    <ComboBox x:Name="Provider" Header="Sample provider" AutomationProperties.Name="Sample provider" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <x:String>Embedded examples</x:String><x:String>Illustrative remote provider</x:String>
                    </ComboBox>
                    <TextBlock Text="Provider sign-in is unavailable until live integration. No authentication or model discovery is performed." Style="{StaticResource ShellSelectableBodyTextStyle}"/>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Style="{StaticResource ShellWorkspaceScrollStyle}" Visibility="Collapsed">
                <StackPanel Spacing="{StaticResource ShellSpaceSmall}">
                    <TextBlock Text="Extensions" Style="{StaticResource ShellSelectableHeadingTextStyle}"/>
                    <ComboBox x:Name="McpServers" Header="MCP servers (samples)" AutomationProperties.Name="MCP servers (samples)" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <x:String>Documentation · available sample</x:String><x:String>Repository · unavailable sample</x:String>
                    </ComboBox>
                    <ComboBox x:Name="Plugins" Header="Plugins (samples)" AutomationProperties.Name="Plugins (samples)" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <x:String>Code review · enabled sample</x:String><x:String>Issue tracker · disabled sample</x:String>
                    </ComboBox>
                    <TextBlock x:Name="ExtensionDetail" Text="Select a sample MCP server or plugin to inspect its status." Style="{StaticResource ShellSelectableBodyTextStyle}"/>
                    <TextBlock Text="Install, update, authentication, and service refresh are unavailable until live integration." Style="{StaticResource ShellSelectableBodyTextStyle}"/>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Style="{StaticResource ShellWorkspaceScrollStyle}" Visibility="Collapsed">
                <StackPanel Spacing="{StaticResource ShellSpaceSmall}">
                    <TextBlock Text="Permissions" Style="{StaticResource ShellSelectableHeadingTextStyle}"/>
                    <ComboBox x:Name="CommandPolicy" Header="Sample command policy" AutomationProperties.Name="Sample command policy" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <x:String>Ask each time</x:String><x:String>Reject by default</x:String>
                    </ComboBox>
                    <ToggleSwitch x:Name="PermissionScope" Header="Show permission scope" IsOn="True"/>
                    <TextBlock Text="These preferences do not authorize commands. Real permission decisions require a connected session." Style="{StaticResource ShellSelectableBodyTextStyle}"/>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Style="{StaticResource ShellWorkspaceScrollStyle}" Visibility="Collapsed">
                <StackPanel Spacing="{StaticResource ShellSpaceSmall}">
                    <TextBlock Text="Appearance" Style="{StaticResource ShellSelectableHeadingTextStyle}"/>
                    <TextBlock Text="The app follows the Windows system theme, including high contrast. Theme persistence is deferred." Style="{StaticResource ShellSelectableBodyTextStyle}"/>
                    <ComboBox x:Name="Density" Header="Sample density preference" AutomationProperties.Name="Sample density preference" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <x:String>Comfortable</x:String><x:String>Compact</x:String>
                    </ComboBox>
                    <ToggleSwitch x:Name="Motion" Header="Sample motion preference" IsOn="True"/>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Style="{StaticResource ShellWorkspaceScrollStyle}" Visibility="Collapsed">
                <StackPanel Spacing="{StaticResource ShellSpaceSmall}">
                    <TextBlock Text="Notifications" Style="{StaticResource ShellSelectableHeadingTextStyle}"/>
                    <ToggleSwitch x:Name="TaskCompletion" Header="Task completion (sample)" IsOn="True"/>
                    <ToggleSwitch x:Name="NeedsAttention" Header="Needs attention (sample)" IsOn="True"/>
                    <Button Content="Show notification example" Click="Notification_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
