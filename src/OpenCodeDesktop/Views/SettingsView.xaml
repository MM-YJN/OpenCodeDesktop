<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenCodeDesktop.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,16,24,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <Button x:Name="ReturnButton" Style="{StaticResource ShellQuietButtonStyle}" HorizontalAlignment="Left" Click="Return_Click" AutomationProperties.Name="Return to workspace">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" Style="{StaticResource ShellIconTextStyle}" FontSize="14" />
                        <TextBlock Text="Return to workspace" Style="{StaticResource ShellBodyTextStyle}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Settings" Style="{StaticResource ShellTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="Connection profiles, workspace storage and application preferences." Style="{StaticResource ShellSecondaryTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE713;" Style="{StaticResource ShellIconTextStyle}" />
                <ComboBox x:Name="Sections" Width="230" AutomationProperties.Name="Settings section" SelectionChanged="Sections_Changed">
                    <x:String>Connections</x:String>
                    <x:String>Models &amp; Providers</x:String>
                    <x:String>Extensions</x:String>
                    <x:String>Permissions</x:String>
                    <x:String>Appearance</x:String>
                    <x:String>Notifications</x:String>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid x:Name="Pages" Grid.Row="1" Padding="24,0,24,16">
            <ContentControl x:Name="ConnectionsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ContentControl x:Name="UnavailableHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
