<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OpenCodeDesktop.Views.ServerEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add server"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">
    <StackPanel Spacing="12" MinWidth="400">
        <TextBox x:Name="ServerName" Header="Name" PlaceholderText="Local development" MaxLength="80" AutomationProperties.Name="Server name" AutomationProperties.AutomationId="ServerEditorName" />
        <TextBox x:Name="ServerOrigin" Header="Server address" MaxLength="256" AutomationProperties.Name="Server address" AutomationProperties.AutomationId="ServerEditorOrigin" />
        <TextBlock x:Name="DefaultAddressHint" Style="{StaticResource ShellTertiaryTextStyle}" TextWrapping="Wrap" />
        <StackPanel x:Name="SavedPasswordPanel" Spacing="4" Visibility="Collapsed">
            <TextBlock Text="Server password" Style="{StaticResource ShellBodyTextStyle}" />
            <Button x:Name="SavedPasswordButton" Style="{StaticResource ShellSecondaryButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Click="SavedPassword_Click" AutomationProperties.Name="Password saved on this device. Activate to enter a new password." AutomationProperties.AutomationId="SavedPasswordChip">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="{StaticResource ShellIconLock}" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconSmall}" IsHitTestVisible="False" />
                    <TextBlock Text="Password saved on this device" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <FontIcon Glyph="{StaticResource ShellIconEdit}" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconSmall}" IsHitTestVisible="False" />
                </StackPanel>
            </Button>
        </StackPanel>
        <PasswordBox x:Name="ServerPassword" Header="Server password" MaxLength="4096" PasswordRevealMode="Peek" AutomationProperties.Name="Server password" AutomationProperties.AutomationId="ServerEditorPassword" />
        <TextBlock x:Name="PasswordHint" Style="{StaticResource ShellTertiaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
        <CheckBox x:Name="RememberCredentials" IsChecked="True" AutomationProperties.AutomationId="ServerEditorRemember">
            <TextBlock Text="Remember credentials on this device" TextWrapping="Wrap" />
        </CheckBox>
        <TextBlock Text="Remembered passwords are protected for your Windows user." Style="{StaticResource ShellTertiaryTextStyle}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="TestButton" Style="{StaticResource ShellSecondaryButtonStyle}" Click="Test_ClickAsync" AutomationProperties.Name="Test connection" AutomationProperties.AutomationId="TestConnection">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="{StaticResource ShellIconPlay}" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconSmall}" IsHitTestVisible="False" />
                    <TextBlock Text="Test connection" IsHitTestVisible="False" />
                </StackPanel>
            </Button>
            <ProgressRing x:Name="TestProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.Name="Testing connection" />
        </StackPanel>
        <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ServerEditorResult" />
    </StackPanel>
</ContentDialog>
