<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="DisconnectedSelectorTemplate">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShellSpaceSmall}">
            <FontIcon Glyph="{StaticResource ShellIconServer}" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconSmall}" Foreground="{ThemeResource ShellTextSecondaryBrush}" IsHitTestVisible="False" />
            <TextBlock Text="Select server" Style="{StaticResource ShellBodyTextStyle}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ConnectedSelectorTemplate">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Width="{StaticResource ShellStatusIndicatorSize}" Height="{StaticResource ShellStatusIndicatorSize}"
                    CornerRadius="{StaticResource ShellStatusIndicatorCornerRadius}" Background="{ThemeResource ShellConnectedBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock x:Name="Name" Style="{StaticResource ShellBodyTextStyle}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                <TextBlock x:Name="Address" Style="{StaticResource ShellTertiaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
            <FontIcon Grid.Column="2" Glyph="{StaticResource ShellIconChevronDown}" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconSmall}" Foreground="{ThemeResource ShellTextSecondaryBrush}" IsHitTestVisible="False" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ServerFlyoutContentTemplate">
        <StackPanel Spacing="{StaticResource ShellSpaceTiny}" MinWidth="300" Padding="8,6">
            <TextBlock Text="SWITCH SERVER" Style="{StaticResource ShellEyebrowTextStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="Empty" Text="No saved servers. Add one in Connections." Style="{StaticResource ShellSecondaryTextStyle}" VerticalAlignment="Center" />
            <StackPanel x:Name="Profiles" Spacing="{StaticResource ShellSpaceTiny}" />
            <Border Style="{StaticResource ShellDividerStyle}" />
            <Button x:Name="Manage" Style="{StaticResource ShellQuietButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Manage connections" AutomationProperties.AutomationId="ManageConnections">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShellSpaceSmall}" VerticalAlignment="Center">
                    <FontIcon Glyph="{StaticResource ShellIconSettings}" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconMedium}" IsHitTestVisible="False" />
                    <TextBlock Text="Manage connections" Style="{StaticResource ShellBodyTextStyle}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ServerFlyoutRowTemplate">
        <Button HorizontalContentAlignment="Stretch">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon x:Name="Icon" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconSmall}" IsHitTestVisible="False" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock x:Name="Name" Style="{StaticResource ShellBodyTextStyle}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                    <TextBlock x:Name="Address" Style="{StaticResource ShellTertiaryTextStyle}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                </StackPanel>
                <ContentControl x:Name="State" Grid.Column="2" IsTabStop="False" />
            </Grid>
        </Button>
    </DataTemplate>
    <DataTemplate x:Key="ConnectionCardTemplate">
        <Border Style="{StaticResource ShellCardStyle}" Padding="14,12,12,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="IconSurface" Width="32" Height="32" CornerRadius="{StaticResource ShellCornerRadiusMedium}" BorderThickness="{StaticResource ShellHairlineThickness}" VerticalAlignment="Top">
                    <FontIcon x:Name="Icon" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconMedium}" IsHitTestVisible="False" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="Name" Style="{StaticResource ShellBodyStrongTextStyle}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Address" Style="{StaticResource ShellTertiaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ContentControl x:Name="State" IsTabStop="False" />
                        <TextBlock x:Name="Version" Style="{StaticResource ShellCaptionTextStyle}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="Select" AutomationProperties.AutomationId="SelectServer" />
                    <Button x:Name="Disconnect" Content="Disconnect" Style="{StaticResource ShellQuietButtonStyle}"
                            AutomationProperties.Name="Disconnect active server" AutomationProperties.AutomationId="DisconnectServer" />
                    <Button x:Name="More" Style="{StaticResource ShellIconButtonStyle}" AutomationProperties.AutomationId="ServerMoreActions">
                        <FontIcon Glyph="{StaticResource ShellIconMore}" FontFamily="{StaticResource ShellIconFontFamily}" FontSize="{StaticResource ShellIconMedium}" IsHitTestVisible="False" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="Edit" Text="Edit server"><MenuFlyoutItem.Icon><FontIcon Glyph="{StaticResource ShellIconEdit}" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="Remove" Text="Remove server"><MenuFlyoutItem.Icon><FontIcon Glyph="{StaticResource ShellIconDelete}" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
