<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Semantic shell resources. Views must use these tokens instead of local
        color, spacing, radius or typography literals so later surfaces can reuse
        the same visual language. Theme dictionaries cover light, dark and high
        contrast; high contrast always pairs a system color with visible text.

        Green is Windows SystemFillColorSuccess for connected/completed state and
        amber is SystemFillColorCaution for attention/recovery state. They mirror
        the concept's status dots; they are not derived from the product accent,
        which is SystemAccentColor (purple on this machine).
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ShellSurfaceBrush" Color="{StaticResource SolidBackgroundFillColorBase}" />
            <SolidColorBrush x:Key="ShellSidebarSurfaceBrush" Color="{StaticResource SolidBackgroundFillColorSecondary}" />
            <SolidColorBrush x:Key="ShellContentSurfaceBrush" Color="{StaticResource LayerFillColorDefault}" />
            <SolidColorBrush x:Key="ShellCardSurfaceBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="ShellElevatedSurfaceBrush" Color="{StaticResource SolidBackgroundFillColorTertiary}" />
            <SolidColorBrush x:Key="ShellStatusSurfaceBrush" Color="{StaticResource SolidBackgroundFillColorSecondary}" />
            <SolidColorBrush x:Key="ShellSubtleSurfaceBrush" Color="{StaticResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="ShellSelectionSurfaceBrush" Color="{StaticResource SystemFillColorAttentionBackground}" />
            <SolidColorBrush x:Key="ShellCodeSurfaceBrush" Color="{StaticResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="ShellTextPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="ShellTextSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="ShellTextTertiaryBrush" Color="{StaticResource TextFillColorTertiary}" />
            <SolidColorBrush x:Key="ShellTextDisabledBrush" Color="{StaticResource TextFillColorDisabled}" />
            <SolidColorBrush x:Key="ShellBorderBrush" Color="{StaticResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="ShellDividerBrush" Color="{StaticResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="ShellAccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ShellAccentTextBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ShellAccentSurfaceBrush" Color="{StaticResource SystemFillColorAttentionBackground}" />
            <SolidColorBrush x:Key="ShellConnectedBrush" Color="{StaticResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="ShellConnectedSurfaceBrush" Color="{StaticResource SystemFillColorSuccessBackground}" />
            <SolidColorBrush x:Key="ShellWarningBrush" Color="{StaticResource SystemFillColorCaution}" />
            <SolidColorBrush x:Key="ShellWarningSurfaceBrush" Color="{StaticResource SystemFillColorCautionBackground}" />
            <SolidColorBrush x:Key="ShellDangerBrush" Color="{StaticResource SystemFillColorCritical}" />
            <SolidColorBrush x:Key="ShellDangerSurfaceBrush" Color="{StaticResource SystemFillColorCriticalBackground}" />
            <SolidColorBrush x:Key="ShellInfoBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ShellInfoSurfaceBrush" Color="{StaticResource SystemFillColorAttentionBackground}" />
            <SolidColorBrush x:Key="ShellDisconnectedBrush" Color="{StaticResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="ShellFocusBrush" Color="{ThemeResource SystemAccentColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ShellSurfaceBrush" Color="{StaticResource SolidBackgroundFillColorBase}" />
            <SolidColorBrush x:Key="ShellSidebarSurfaceBrush" Color="{StaticResource SolidBackgroundFillColorSecondary}" />
            <SolidColorBrush x:Key="ShellContentSurfaceBrush" Color="{StaticResource LayerFillColorDefault}" />
            <SolidColorBrush x:Key="ShellCardSurfaceBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="ShellElevatedSurfaceBrush" Color="{StaticResource SolidBackgroundFillColorTertiary}" />
            <SolidColorBrush x:Key="ShellStatusSurfaceBrush" Color="{StaticResource SolidBackgroundFillColorSecondary}" />
            <SolidColorBrush x:Key="ShellSubtleSurfaceBrush" Color="{StaticResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="ShellSelectionSurfaceBrush" Color="{StaticResource SystemFillColorAttentionBackground}" />
            <SolidColorBrush x:Key="ShellCodeSurfaceBrush" Color="{StaticResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="ShellTextPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="ShellTextSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="ShellTextTertiaryBrush" Color="{StaticResource TextFillColorTertiary}" />
            <SolidColorBrush x:Key="ShellTextDisabledBrush" Color="{StaticResource TextFillColorDisabled}" />
            <SolidColorBrush x:Key="ShellBorderBrush" Color="{StaticResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="ShellDividerBrush" Color="{StaticResource DividerStrokeColorDefault}" />
            <SolidColorBrush x:Key="ShellAccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ShellAccentTextBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ShellAccentSurfaceBrush" Color="{StaticResource SystemFillColorAttentionBackground}" />
            <SolidColorBrush x:Key="ShellConnectedBrush" Color="{StaticResource SystemFillColorSuccess}" />
            <SolidColorBrush x:Key="ShellConnectedSurfaceBrush" Color="{StaticResource SystemFillColorSuccessBackground}" />
            <SolidColorBrush x:Key="ShellWarningBrush" Color="{StaticResource SystemFillColorCaution}" />
            <SolidColorBrush x:Key="ShellWarningSurfaceBrush" Color="{StaticResource SystemFillColorCautionBackground}" />
            <SolidColorBrush x:Key="ShellDangerBrush" Color="{StaticResource SystemFillColorCritical}" />
            <SolidColorBrush x:Key="ShellDangerSurfaceBrush" Color="{StaticResource SystemFillColorCriticalBackground}" />
            <SolidColorBrush x:Key="ShellInfoBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="ShellInfoSurfaceBrush" Color="{StaticResource SystemFillColorAttentionBackground}" />
            <SolidColorBrush x:Key="ShellDisconnectedBrush" Color="{StaticResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="ShellFocusBrush" Color="{ThemeResource SystemAccentColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ShellSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellSidebarSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellContentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellCardSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellElevatedSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellStatusSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellSubtleSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellSelectionSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellCodeSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShellTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShellTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShellTextDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ShellBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShellDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShellAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ShellAccentTextBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ShellAccentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellConnectedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShellConnectedSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShellWarningSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShellDangerSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellInfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShellInfoSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShellDisconnectedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShellFocusBrush" Color="{ThemeResource SystemColorHotlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Spacing: all values are DIPs. -->
    <x:Double x:Key="ShellSpaceTiny">4</x:Double>
    <x:Double x:Key="ShellSpaceSmall">8</x:Double>
    <x:Double x:Key="ShellSpaceCompact">12</x:Double>
    <x:Double x:Key="ShellSpaceMedium">16</x:Double>
    <x:Double x:Key="ShellSpaceLarge">24</x:Double>
    <x:Double x:Key="ShellSpaceXLarge">32</x:Double>

    <Thickness x:Key="ShellContentPadding">24</Thickness>
    <Thickness x:Key="ShellPanePadding">12</Thickness>
    <Thickness x:Key="ShellCardPadding">16</Thickness>
    <Thickness x:Key="ShellCardSpaciousPadding">24</Thickness>
    <Thickness x:Key="ShellStatusPadding">16,6</Thickness>
    <Thickness x:Key="ShellTitleBarPadding">16,0,0,0</Thickness>
    <Thickness x:Key="ShellSidebarPadding">12,16</Thickness>
    <Thickness x:Key="ShellWorkspaceHeaderPadding">20,12</Thickness>
    <Thickness x:Key="ShellComposerMargin">0,16</Thickness>
    <Thickness x:Key="ShellHairlineThickness">1</Thickness>
    <Thickness x:Key="ShellStatusBorderThickness">0,1,0,0</Thickness>
    <Thickness x:Key="ShellHeaderBorderThickness">0,0,0,1</Thickness>
    <Thickness x:Key="ShellInspectorBorderThickness">1,0,0,0</Thickness>
    <Thickness x:Key="ShellProjectsBorderThickness">0,0,1,0</Thickness>

    <CornerRadius x:Key="ShellCornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="ShellStatusIndicatorCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="ShellCornerRadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="ShellCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ShellCornerRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="ShellCornerRadiusBadge">6</CornerRadius>

    <!-- Typography. -->
    <x:Double x:Key="ShellCaptionFontSize">12</x:Double>
    <x:Double x:Key="ShellTitleBarFontSize">13</x:Double>
    <x:Double x:Key="ShellBodyFontSize">14</x:Double>
    <x:Double x:Key="ShellSubheadingFontSize">16</x:Double>
    <x:Double x:Key="ShellHeadingFontSize">20</x:Double>
    <x:Double x:Key="ShellTitleFontSize">28</x:Double>
    <x:Double x:Key="ShellLineHeight">20</x:Double>
    <x:Double x:Key="ShellContentMaximumWidth">760</x:Double>
    <FontFamily x:Key="ShellCodeFontFamily">Cascadia Mono,Consolas</FontFamily>
    <FontFamily x:Key="ShellIconFontFamily">Segoe MDL2 Assets</FontFamily>

    <!-- Window, pane and composer sizing. -->
    <x:Double x:Key="ShellWindowInitialWidth">1440</x:Double>
    <x:Double x:Key="ShellWindowInitialHeight">900</x:Double>
    <x:Double x:Key="ShellWindowMinimumWidth">640</x:Double>
    <x:Double x:Key="ShellWindowMinimumHeight">480</x:Double>
    <x:Double x:Key="ShellTitleBarHeight">48</x:Double>
    <x:Double x:Key="ShellStatusIndicatorSize">8</x:Double>
    <x:Double x:Key="ShellProjectsPanelWidth">288</x:Double>
    <x:Double x:Key="ShellProjectsInlineThreshold">1000</x:Double>
    <x:Double x:Key="ShellInspectorInlineThreshold">1000</x:Double>
    <x:Double x:Key="ShellDetailsWidth">400</x:Double>
    <x:Double x:Key="ShellDetailsMinimumWidth">320</x:Double>
    <x:Double x:Key="ShellConversationMinimumWidth">420</x:Double>
    <x:Double x:Key="ShellComposerMaximumHeight">240</x:Double>
    <x:Double x:Key="ShellTerminalHeight">180</x:Double>
    <x:Double x:Key="ShellIconSmall">14</x:Double>
    <x:Double x:Key="ShellIconMedium">16</x:Double>
    <x:Double x:Key="ShellIconLarge">20</x:Double>
    <x:Double x:Key="ShellTouchTarget">32</x:Double>
    <x:Double x:Key="ShellTreeProjectRowHeight">44</x:Double>
    <x:Double x:Key="ShellTreeSessionRowHeight">32</x:Double>
    <x:Double x:Key="ShellTreeActionSize">28</x:Double>

    <!-- Fluent MDL2 glyphs used consistently by the shell. -->
    <x:String x:Key="ShellIconServer">&#xE968;</x:String>
    <x:String x:Key="ShellIconSettings">&#xE713;</x:String>
    <x:String x:Key="ShellIconFolder">&#xE8B7;</x:String>
    <x:String x:Key="ShellIconFile">&#xE7C3;</x:String>
    <x:String x:Key="ShellIconAdd">&#xE710;</x:String>
    <x:String x:Key="ShellIconRemove">&#xE738;</x:String>
    <x:String x:Key="ShellIconMore">&#xE712;</x:String>
    <x:String x:Key="ShellIconSend">&#xE724;</x:String>
    <x:String x:Key="ShellIconStop">&#xE71A;</x:String>
    <x:String x:Key="ShellIconRefresh">&#xE72C;</x:String>
    <x:String x:Key="ShellIconDetails">&#xE8A0;</x:String>
    <x:String x:Key="ShellIconClosePane">&#xE89F;</x:String>
    <x:String x:Key="ShellIconExpand">&#xE740;</x:String>
    <x:String x:Key="ShellIconRestore">&#xE73F;</x:String>
    <x:String x:Key="ShellIconTerminal">&#xE756;</x:String>
    <x:String x:Key="ShellIconWarning">&#xE7BA;</x:String>
    <x:String x:Key="ShellIconError">&#xE783;</x:String>
    <x:String x:Key="ShellIconInfo">&#xE946;</x:String>
    <x:String x:Key="ShellIconCheck">&#xE73E;</x:String>
    <x:String x:Key="ShellIconChevronDown">&#xE70D;</x:String>
    <x:String x:Key="ShellIconChevronRight">&#xE76C;</x:String>
    <x:String x:Key="ShellIconUser">&#xE77B;</x:String>
    <x:String x:Key="ShellIconAssistant">&#xE99A;</x:String>
    <x:String x:Key="ShellIconTool">&#xE90F;</x:String>
    <x:String x:Key="ShellIconLock">&#xE72E;</x:String>
    <x:String x:Key="ShellIconClock">&#xE823;</x:String>
    <x:String x:Key="ShellIconHistory">&#xE81C;</x:String>
    <x:String x:Key="ShellIconEdit">&#xE70F;</x:String>
    <x:String x:Key="ShellIconDelete">&#xE74D;</x:String>
    <x:String x:Key="ShellIconPlay">&#xE768;</x:String>
    <x:String x:Key="ShellIconAttach">&#xE723;</x:String>
    <x:String x:Key="ShellIconSearch">&#xE721;</x:String>
    <x:String x:Key="ShellIconMessage">&#xE8BD;</x:String>

    <!-- Text styles. -->
    <Style x:Key="ShellCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource ShellCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource ShellTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ShellEyebrowTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ShellCaptionTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="30" />
        <Setter Property="Foreground" Value="{ThemeResource ShellTextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="ShellBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource ShellBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource ShellTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ShellBodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ShellBodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ShellTitleBarTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ShellBodyStrongTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource ShellTitleBarFontSize}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ShellSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ShellBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource ShellTextSecondaryBrush}" />
    </Style>
    <Style x:Key="ShellTertiaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ShellCaptionTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource ShellTextTertiaryBrush}" />
    </Style>
    <Style x:Key="ShellSubheadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource ShellSubheadingFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource ShellTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ShellHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource ShellHeadingFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource ShellTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ShellTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource ShellTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource ShellTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ShellSelectableBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ShellBodyTextStyle}">
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>
    <Style x:Key="ShellSelectableHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ShellHeadingTextStyle}">
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>
    <Style x:Key="ShellCodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ShellCodeFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="Foreground" Value="{ThemeResource ShellTextPrimaryBrush}" />
    </Style>
    <Style x:Key="ShellWrappedCodeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ShellCodeTextStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ShellIconTextStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource ShellIconFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource ShellIconMedium}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Surfaces and separators. -->
    <Style x:Key="ShellCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ShellCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ShellHairlineThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource ShellCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource ShellCardPadding}" />
    </Style>
    <Style x:Key="ShellSubtleCardStyle" TargetType="Border" BasedOn="{StaticResource ShellCardStyle}">
        <Setter Property="Background" Value="{ThemeResource ShellSubtleSurfaceBrush}" />
    </Style>
    <Style x:Key="ShellCodeBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ShellCodeSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ShellHairlineThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadiusMedium}" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="ShellBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadiusBadge}" />
        <Setter Property="BorderThickness" Value="{StaticResource ShellHairlineThickness}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ShellBorderBrush}" />
        <Setter Property="Background" Value="{ThemeResource ShellSubtleSurfaceBrush}" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style x:Key="ShellBannerStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource ShellCardCornerRadius}" />
        <Setter Property="BorderThickness" Value="{StaticResource ShellHairlineThickness}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ShellBorderBrush}" />
        <Setter Property="Background" Value="{ThemeResource ShellSubtleSurfaceBrush}" />
        <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style x:Key="ShellDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource ShellDividerBrush}" />
    </Style>
    <Style x:Key="ShellVerticalDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{ThemeResource ShellDividerBrush}" />
    </Style>

    <!-- Buttons. Native templates continue to own pointer, focus and high-contrast states. -->
    <Style x:Key="ShellPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadiusMedium}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="ShellSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadiusMedium}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="ShellQuietButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadiusMedium}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style x:Key="ShellIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="{StaticResource ShellTouchTarget}" />
        <Setter Property="Height" Value="{StaticResource ShellTouchTarget}" />
        <Setter Property="MinWidth" Value="{StaticResource ShellTouchTarget}" />
        <Setter Property="MinHeight" Value="{StaticResource ShellTouchTarget}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadiusMedium}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="ShellTreeActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellQuietButtonStyle}">
        <Setter Property="Width" Value="{StaticResource ShellTreeActionSize}" />
        <Setter Property="Height" Value="{StaticResource ShellTreeActionSize}" />
        <Setter Property="MinWidth" Value="{StaticResource ShellTreeActionSize}" />
        <Setter Property="MinHeight" Value="{StaticResource ShellTreeActionSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadiusSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="ShellProjectTreeItemStyle" TargetType="TreeViewItem">
        <Setter Property="MinHeight" Value="{StaticResource ShellTreeSessionRowHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="GlyphBrush" Value="{ThemeResource ShellTextSecondaryBrush}" />
    </Style>
    <Style x:Key="ShellNavigationRowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadiusMedium}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="ShellSelectedNavigationRowStyle" TargetType="Button" BasedOn="{StaticResource ShellNavigationRowStyle}">
        <Setter Property="Background" Value="{ThemeResource ShellSelectionSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource ShellAccentBrush}" />
    </Style>
    <Style x:Key="ShellComposerSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ShellCardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ShellBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ShellHairlineThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource ShellCornerRadiusLarge}" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="ShellWorkspaceScrollStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollMode" Value="Auto" />
    </Style>
</ResourceDictionary>
