    </Project>
    <Project Path="src/OpenCodeDesktop.Core/OpenCodeDesktop.Core.csproj" />
    <Project Path="src/OpenCodeDesktop.Infrastructure/OpenCodeDesktop.Infrastructure.csproj" />
  </Folder>
  <Folder Name="/tests/">
